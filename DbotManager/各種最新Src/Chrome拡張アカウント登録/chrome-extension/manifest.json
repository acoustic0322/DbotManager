{
  "manifest_version": 3,
  "name": "DBot Account Manager",
  "version": "0.0.0",
  "description": "XのCookie・アカウント情報を取得し、D-BOTシステムへアカウント情報の追加・更新を行います。",
  "permissions": [ "cookies", "storage", "tabs", "scripting", "activeTab" ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://d-bot.happywinds.net/*"
  ],
  "action": {
    "default_title": "DBot Account Manager",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}